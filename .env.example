# Server-only PostgreSQL connection. Use the environment-specific app login
# that inherits app_runtime; never expose this value through NEXT_PUBLIC_*.
DATABASE_URL=postgresql://<runtime-user>:<password>@<pooler-host>:6543/postgres

# Public browser/server Auth configuration. For the local stack, copy API_URL
# and ANON_KEY from `npm run auth:status`; the local signing origin must use the
# literal localhost hostname because insecure Web3 message URIs on 127.0.0.1
# are rejected by Supabase Auth. These values are public; never use SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local-ANON_KEY>
NEXT_PUBLIC_SITE_URL=http://localhost:3100
